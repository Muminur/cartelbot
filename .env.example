# Database
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/cartelbot?retryWrites=true&w=majority

# Application
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000

# Binance
# CRITICAL: BINANCE_API_URL = Mainnet (production), BINANCE_TESTNET_URL = Testnet (testing)
# DO NOT set both to testnet URLs - mainnet trades will fail with -2013 errors!
#
# Mainnet (production): https://api.binance.com
# Testnet (testing): https://testnet.binance.vision
#
# The application automatically selects the correct network based on user settings (useTestnet flag).
# When useTestnet=false, queries go to BINANCE_API_URL (mainnet)
# When useTestnet=true, queries go to BINANCE_TESTNET_URL (testnet)
BINANCE_API_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443
BINANCE_TESTNET_URL=https://testnet.binance.vision
BINANCE_TESTNET_WS=wss://stream.testnet.binance.vision:9443

# Security (Generate secure random strings for production)
# Use: openssl rand -hex 32
ENCRYPTION_KEY=your-32-character-encryption-key-here
JWT_SECRET=your-32-character-jwt-secret-here
NEXTAUTH_SECRET=your-32-character-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# Email (Optional - Required for magic link auth)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Admin
ADMIN_EMAILS=admin@cartelbot.coinspree.cc

# Admin IP Whitelist (Optional - Comma-separated IPs)
# Leave empty to allow admin access from any IP
# Example: ADMIN_IP_WHITELIST=192.168.1.100,10.0.0.5
ADMIN_IP_WHITELIST=

# ============================================================
# MILESTONE 8: SUBSCRIPTION & PAYMENTS
# ============================================================
# ⚠️ CRITICAL: These variables are REQUIRED in production
# - Missing PAYMENT_WALLET_ADDRESS will prevent app startup
# - Users can register but cannot subscribe without valid wallet
# ============================================================

# PAYMENT_WALLET_ADDRESS: Your TRC20 (Tron blockchain) wallet address for receiving USDT payments
# - Must start with 'T' and be exactly 34 characters (example: TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t)
# - Get your wallet from: TronLink browser extension, Binance withdrawal address, or any Tron wallet
# - ⚠️ IMPORTANT: Replace placeholder before deployment or subscription payments will fail
# - Verify your address exists: https://tronscan.org/#/address/YOUR_ADDRESS_HERE
# - Security: Funds sent to invalid addresses cannot be recovered
PAYMENT_WALLET_ADDRESS=TYourWalletAddressHere123456789ABCDEF

# TRON_MIN_CONFIRMATIONS: Number of block confirmations required before marking payment as verified
# - Default: 19 (if not set or empty, defaults to 19 confirmations)
# - Recommended range: 10-30 (lower = faster confirmation, higher = more secure)
# - Industry standard: Binance uses 20, Kraken uses 18
# - Timing: ~3 seconds per block → 19 confirmations ≈ 57 seconds total wait time
TRON_MIN_CONFIRMATIONS=19
